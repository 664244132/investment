# ==============================================================================
# 🚫 .gitignore: Git Ignore Rules for SmartPort AI Investment Platform
# ==============================================================================

# --- 1. Environment & Sensitive Config Files ---
.env
.env.local
.env.*.local
*.env
config/secrets.php
config/*.local.php

# --- 2. PHP & Web Server Logs, Dumps & Temp Files ---
logs/
*.log
error_log
php_errors.log
php_error_log
apache_errors.log
mysql_error.log
*.tmp
*.temp
tmp/
temp/
scratch/
*.pid

# --- 3. Package Managers & Dependency Directories ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
vendor/
composer.phar

# --- 4. AI Agents & Local Coding Harness Tools ---
.agents/
.codex/
.gemini/
.claude/
skills-lock.json
.antigravityignore

# --- 5. Frontend Prototype Build Caches (AI Stock folder) ---
AI Stock/

# --- 6. Operating System Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- 7. IDE & Code Editor Configurations ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
.history/
.directory

# --- 8. Local Database Backups & Temporary SQL Dumps ---
*.sql.gz
*.sql.bak
dump.sql
backup.sql
*.dmp
*.bak
